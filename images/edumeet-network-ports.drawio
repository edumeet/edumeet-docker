        <mxCell id="turn-note" value="The browser connects to TURN on 443/TCP. Coturn exchanges relayed media with the media node over UDP." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="50" y="765" width="1200" height="30" as="geometry"/></mxCell>
