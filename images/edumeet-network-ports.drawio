        <mxCell id="turn-control-label" value="restricted" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="662" y="712" width="120" height="25" as="geometry"/></mxCell>
