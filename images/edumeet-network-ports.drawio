        <mxCell id="edge-web-services" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web-proxy" target="web-services"><mxGeometry relative="1" as="geometry"/></mxCell>
