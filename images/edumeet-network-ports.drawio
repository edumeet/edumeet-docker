        <mxCell id="turn-proxy" value="&lt;b&gt;Nginx proxy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:15px&quot;&gt;media domain; internal 3479&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="390" y="660" width="240" height="88" as="geometry"/></mxCell>
        <mxCell id="turn-coturn" value="&lt;b&gt;Coturn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:15px&quot;&gt;host network&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#fff7e6;strokeColor=#b7791f;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="815" y="660" width="220" height="88" as="geometry"/></mxCell>
