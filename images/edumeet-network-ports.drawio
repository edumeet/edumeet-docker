<mxfile host="app.diagrams.net">
  <diagram id="network-ports" name="Network and ports">
    <mxGraphModel dx="1500" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="930" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="panel-web" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="105" width="1440" height="220" as="geometry"/></mxCell>
        <mxCell id="panel-direct" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="1440" height="205" as="geometry"/></mxCell>
        <mxCell id="panel-turn" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="570" width="1440" height="250" as="geometry"/></mxCell>

        <mxCell id="title" value="eduMEET Docker: network paths and default ports" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Arrows show connection paths. Public ports cross the internet-facing firewall; internal ports are not public." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=18;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1350" height="30" as="geometry"/></mxCell>
        <mxCell id="heading-web" value="1. Website and signaling" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="600" height="40" as="geometry"/></mxCell>
        <mxCell id="heading-direct" value="2. Direct audio, video, and other media" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="heading-turn" value="3. TURN relay when a direct connection is not possible" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="50" y="575" width="900" height="40" as="geometry"/></mxCell>

        <mxCell id="web-browser" value="&lt;b&gt;User's browser&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:15px&quot;&gt;Internet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#e8f2ff;strokeColor=#3974b8;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="200" height="88" as="geometry"/></mxCell>
        <mxCell id="web-proxy" value="&lt;b&gt;Nginx proxy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:15px&quot;&gt;main domain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=2;fontFamily=Arial;fontSize=20;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="390" y="190" width="240" height="88" as="geometry"/></mxCell>
        <mxCell id="web-services" value="&lt;b style=&quot;font-size:20px&quot;&gt;Internal services&lt;/b&gt;&lt;br&gt;&lt;br&gt;Client website, room server, management server, Keycloak&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:15px&quot;&gt;Management server connects to the database; authentication is optional.&lt;br&gt;Port 80 also serves HTTP certificate validation and redirects to HTTPS.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=20;arcSize=9;fillColor=#fff7e6;strokeColor=#b7791f;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="815" y="165" width="610" height="138" as="geometry"/></mxCell>
