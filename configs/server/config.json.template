{
	"liveReload": false,
	"prometheus": {
		"enabled": false,
		"period": 10,
		"listener": [
			{
				"ip": "0.0.0.0",
				"port": 3080,
				"protocol": "http"
			}
		]
	},
	"listenPort": "8443",
	"listenHost": "0.0.0.0",
"managementService": {
	"host": "http://edumeet-management-server:3030",
	"jwtPublicKeys": [
		"${MGMT_PUB}"
	]
},
	"defaultRoomSettings": {
			"defaultRole": {
					"name": "Default",
					"description": "Default role",
					"permissions": [
							{ "name": "SEND_CHAT" },
							{ "name": "SHARE_AUDIO" },
							{ "name": "SHARE_VIDEO" },
							{ "name": "SHARE_SCREEN" },
							{ "name": "SHARE_EXTRA_VIDEO" },
							{ "name": "SHARE_FILE" },
							{ "name": "CHANGE_ROOM" }
					]
			},
			"locked": false
	},
	"mediaNodes": [{
			"hostname": "${LISTEN_IP}",
			"port": 3000,
			"secret": "${MEDIA_SECRET}",
			"ca": "/certs/media-node/cert.pem",
			"latitude": 63.430481,
			"longitude": 10.394964,
			"turnHostname": "${MEDIA_DOMAIN}",
			"turnports" :  [
				{
					"protocol":"turns",
					"port": 443,
					"transport": "tcp"
				}
			]
	}]
}